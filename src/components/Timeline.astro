---
interface Post {
  id: string;
  slug: string;
  title: string;
  pubDate: Date;
  pr?: string;
}

interface Props {
  posts: Post[];
  experimentSlug: string;
}

const { posts, experimentSlug } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};
---

<div class="timeline">
  {posts.map((post) => (
    <div class="timeline-item">
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
        <time class="text-xs text-[--color-text-dim] font-mono shrink-0">
          {formatDate(post.pubDate)}
        </time>
        <div>
          <a
            href={`/${experimentSlug}/${post.slug}/`}
            class="text-[--color-text] hover:text-[--color-accent] font-medium"
          >
            {post.title}
          </a>
          {post.pr && (
            <a
              href={post.pr}
              target="_blank"
              rel="noopener noreferrer"
              class="ml-2 text-xs text-[--color-text-dim] hover:text-[--color-accent]"
            >
              PR
            </a>
          )}
        </div>
      </div>
    </div>
  ))}
</div>
