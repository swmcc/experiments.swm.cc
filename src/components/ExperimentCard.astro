---
interface Props {
  slug: string;
  title: string;
  tagline?: string;
  description: string;
  status: 'active' | 'paused' | 'completed' | 'archived';
  started: Date;
  tags?: string[];
  postCount: number;
}

const { slug, title, tagline, description, status, started, tags = [], postCount } = Astro.props;

const statusLabels = {
  active: 'Active',
  paused: 'Paused',
  completed: 'Completed',
  archived: 'Archived',
};
---

<a href={`/${slug}/`} class="card block group">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h2 class="text-xl font-semibold group-hover:text-[--color-accent] transition-colors">
      {title}
    </h2>
    <span class={`status-badge ${status} shrink-0`}>
      {statusLabels[status]}
    </span>
  </div>

  {tagline && (
    <p class="text-[--color-text-muted] text-sm italic mb-3">"{tagline}"</p>
  )}

  <p class="text-[--color-text-muted] text-sm mb-4 line-clamp-2">
    {description}
  </p>

  <div class="flex items-center justify-between text-xs text-[--color-text-dim]">
    <div class="flex gap-2">
      {tags.slice(0, 3).map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    <span class="font-mono">
      {postCount} {postCount === 1 ? 'post' : 'posts'}
    </span>
  </div>
</a>
