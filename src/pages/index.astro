---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const experiments = await getCollection('experiments');
const posts = await getCollection('posts');

const getPostCount = (experimentSlug: string) => {
  return posts.filter((post) => post.id.startsWith(experimentSlug + '/')).length;
};

const sortedExperiments = experiments.sort((a, b) => {
  const statusOrder = { active: 0, paused: 1, completed: 2, archived: 3 };
  const statusDiff = statusOrder[a.data.status] - statusOrder[b.data.status];
  if (statusDiff !== 0) return statusDiff;
  return b.data.started.getTime() - a.data.started.getTime();
});

const statusLabels = {
  active: 'ACTIVE',
  paused: 'PAUSED',
  completed: 'COMPLETED',
  archived: 'ARCHIVED',
};

const experimentImages: Record<string, string> = {
  'the-wire-graph': '/the-wire-graph.png',
  'indexatron': '/indexatron.png',
};
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden border-b border-[--color-border]">
    <!-- Animated grid background -->
    <div class="absolute inset-0 opacity-20">
      <div class="grid-bg"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 py-20">
      <!-- Terminal window -->
      <div class="terminal-window text-left max-w-2xl mx-auto">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="terminal-title">~/sandbox</span>
        </div>
        <div class="terminal-body font-mono text-sm">
          <div class="terminal-content">
            <div class="terminal-text">
              <div class="line"><span class="prompt">$</span> ./init_sandbox.sh</div>
              <div class="output mt-3">
                <p class="text-[--color-accent]">[OK] Initialising sandbox environment...</p>
                <p class="text-[--color-text-muted] mt-2">&gt; A perpetual work-in-progress.</p>
                <p class="text-[--color-text-muted]">&gt; Ideas mutate. Code evolves. Nothing is final.</p>
                <p class="text-[--color-text-muted]">&gt; Just a place to tinker, break things,</p>
                <p class="text-[--color-text-muted]">&gt; and occasionally build something useful.</p>
              </div>
              <div class="line mt-4"><span class="prompt">$</span> cat /proc/experiments</div>
              <div class="output mt-2">
                {sortedExperiments.map((exp) => {
                  const slug = exp.id.replace('/index', '');
                  return <p class="text-[--color-accent]">[RUNNING] {slug} <span class="text-[--color-text-dim]">pid:{Math.floor(Math.random() * 9000) + 1000}</span></p>;
                })}
              </div>
              <div class="line mt-4 flex items-center">
                <span class="prompt">$</span>
                <span class="cursor"></span>
              </div>
            </div>
            <div class="terminal-avatar">
              <img
                src="https://swm.cc/profile.svg"
                alt="Profile"
                class="avatar-img"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experiments Grid - Full Width -->
  <section class="py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-mono text-xs text-[--color-text-dim] tracking-widest uppercase mb-8">
        Experiments ({sortedExperiments.length})
      </h2>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {sortedExperiments.map((experiment) => {
          const slug = experiment.id.replace('/index', '');
          const postCount = getPostCount(slug);
          const image = experimentImages[slug] || experiment.data.cover;

          return (
            <a href={`/${slug}/`} class="experiment-card group">
              {image && (
                <div class="card-image">
                  <img src={image} alt={experiment.data.title} />
                  <div class="image-overlay"></div>
                </div>
              )}
              <div class="card-content">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h3 class="text-xl font-semibold group-hover:text-[--color-accent] transition-colors">
                    {experiment.data.title}
                  </h3>
                  <span class={`status-badge ${experiment.data.status}`}>
                    {statusLabels[experiment.data.status]}
                  </span>
                </div>

                {experiment.data.tagline && (
                  <p class="text-[--color-text-muted] text-sm italic mb-3">
                    "{experiment.data.tagline}"
                  </p>
                )}

                <p class="text-[--color-text-muted] text-sm mb-4 line-clamp-2">
                  {experiment.data.description}
                </p>

                <div class="flex items-center justify-between text-xs">
                  <div class="flex gap-2">
                    {experiment.data.tags?.slice(0, 3).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <span class="font-mono text-[--color-text-dim]">
                    {postCount} {postCount === 1 ? 'post' : 'posts'}
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {sortedExperiments.length === 0 && (
        <div class="text-center py-20">
          <p class="font-mono text-[--color-text-dim]">No experiments running.</p>
          <p class="font-mono text-[--color-text-dim]">Check back soon.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .grid-bg {
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 50px 50px;
    width: 100%;
    height: 100%;
    animation: grid-move 20s linear infinite;
  }

  @keyframes grid-move {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }

  .terminal-window {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .terminal-header {
    background: var(--color-bg);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .terminal-title {
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .terminal-body {
    padding: 1.5rem;
    min-height: 240px;
  }

  .terminal-content {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .terminal-text {
    flex: 1;
  }

  .terminal-avatar {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    opacity: 0.7;
    animation: spin-pause 8s ease-in-out infinite;
  }

  @keyframes spin-pause {
    0%, 80% { transform: rotate(0deg); }
    90% { transform: rotate(360deg); }
    100% { transform: rotate(360deg); }
  }

  .line {
    display: flex;
    gap: 0.5rem;
  }

  .prompt {
    color: var(--color-accent);
    font-weight: 600;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .experiment-card {
    display: block;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .experiment-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(52, 211, 153, 0.1);
  }

  .card-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .experiment-card:hover .card-image img {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--color-bg-card) 100%);
  }

  .card-content {
    padding: 1.5rem;
  }

  @media (max-width: 640px) {
    .terminal-content {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .terminal-avatar {
      margin-bottom: 1rem;
    }

    .line {
      justify-content: center;
    }
  }
</style>
