---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A digital lab notebook' } = Astro.props;
const fullTitle = title === 'Home' ? 'experiments.swm.cc' : `${title} | experiments.swm.cc`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="border-b border-[--color-border] bg-[--color-bg]/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="container py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-mono text-lg font-semibold hover:text-[--color-accent]">
          <svg class="w-5 h-5 text-[--color-accent]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3h6v4.5l3 9A3 3 0 0 1 15.17 21H8.83A3 3 0 0 1 6 16.5l3-9V3z" />
            <path d="M9 3h6" />
            <circle cx="12" cy="15" r="1" fill="currentColor" />
            <circle cx="10" cy="17" r="0.5" fill="currentColor" />
            <circle cx="14" cy="16" r="0.5" fill="currentColor" />
          </svg>
          experiments<span class="text-[--color-text-dim]">.swm.cc</span>
        </a>
        <nav class="flex gap-6 font-mono text-sm">
          <a href="/" class="text-[--color-text-muted] hover:text-[--color-text]">home</a>
          <a href="/about" class="text-[--color-text-muted] hover:text-[--color-text]">about</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-[--color-border] mt-16">
      <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <!-- Branding -->
          <div>
            <h3 class="font-mono font-semibold text-[--color-text] mb-3">experiments.swm.cc</h3>
            <p class="text-sm text-[--color-text-muted]">
              A digital lab notebook. Ideas, explorations, and things in progress.
            </p>
          </div>

          <!-- Quick Links -->
          <div>
            <h3 class="font-mono text-xs text-[--color-text-dim] uppercase tracking-wider mb-3">Quick Links</h3>
            <nav class="flex flex-col gap-2 text-sm">
              <a href="/" class="text-[--color-text-muted] hover:text-[--color-accent]">Home</a>
              <a href="/about" class="text-[--color-text-muted] hover:text-[--color-accent]">About</a>
              <a href="/colophon" class="text-[--color-text-muted] hover:text-[--color-accent]">Colophon</a>
              <a href="/feed.xml" class="text-[--color-text-muted] hover:text-[--color-accent]">RSS Feed</a>
            </nav>
          </div>

          <!-- Connect -->
          <div>
            <h3 class="font-mono text-xs text-[--color-text-dim] uppercase tracking-wider mb-3">Elsewhere</h3>
            <nav class="flex flex-col gap-2 text-sm">
              <a href="https://swm.cc" target="_blank" rel="noopener" class="text-[--color-text-muted] hover:text-[--color-accent]">swm.cc</a>
            </nav>
          </div>
        </div>

        <!-- Copyright -->
        <div class="pt-8 border-t border-[--color-border] text-center text-sm text-[--color-text-dim]">
          <p>&copy; 2026 Stephen McCullough. Built with ❤️</p>
        </div>
      </div>
    </footer>
  </body>
</html>
